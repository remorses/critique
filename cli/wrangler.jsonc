{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "critique-web",
  "main": "src/worker.tsx",
  "compatibility_date": "2025-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // Static assets (fonts)
  "assets": {
    "directory": "./public"
  },

  // Small records: licenses, owner secrets
  "kv_namespaces": [
    {
      "binding": "CRITIQUE_KV",
      "id": "844b10c9fea049c8b20fa4a8c5cae44e"
    }
  ],

  // Diff HTML, patches and OG images. Lifecycle rule deletes ttl/ after 7 days.
  "r2_buckets": [
    {
      "binding": "CRITIQUE_DIFFS",
      "bucket_name": "critique-diffs"
    }
  ],

  // The comments feature (CommentRoom) was removed; v2 deletes its Durable Object storage
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CommentRoom"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["CommentRoom"]
    }
  ],

  // Custom domain
  "routes": [
    { "pattern": "critique.work", "custom_domain": true },
    { "pattern": "www.critique.work", "custom_domain": true }
  ],

  // Preview environment for testing before production deploy
  "env": {
    "preview": {
      "name": "critique-web-preview",
      "routes": [
        { "pattern": "preview.critique.work", "custom_domain": true }
      ],
      "kv_namespaces": [
        {
          "binding": "CRITIQUE_KV",
          "id": "844b10c9fea049c8b20fa4a8c5cae44e"
        }
      ],
      "r2_buckets": [
        {
          "binding": "CRITIQUE_DIFFS",
          "bucket_name": "critique-diffs-preview"
        }
      ]
    }
  }
}
